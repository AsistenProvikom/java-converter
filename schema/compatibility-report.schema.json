{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://provikom.org/schema/v1/compatibility-report.json",
  "title": "ProvikomCompatibilityReport",
  "description": "Standardized schema for Provikom Converter Java game compatibility evaluation reports.",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "archive_summary",
    "manifest",
    "class_file_info",
    "features_detected",
    "backend_compatibility",
    "recommendation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "format": "uri"
    },
    "metadata": {
      "type": "object",
      "required": [
        "tool_name",
        "tool_version",
        "analysis_timestamp",
        "target_file",
        "file_size_bytes",
        "sha256"
      ],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "analysis_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "target_file": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "archive_summary": {
      "type": "object",
      "required": [
        "total_entries",
        "total_classes",
        "total_resources",
        "total_native_libraries",
        "total_nested_archives",
        "total_uncompressed_bytes",
        "total_compressed_bytes",
        "resource_breakdown",
        "security_warnings"
      ],
      "properties": {
        "total_entries": {
          "type": "integer",
          "minimum": 0
        },
        "total_classes": {
          "type": "integer",
          "minimum": 0
        },
        "total_resources": {
          "type": "integer",
          "minimum": 0
        },
        "total_native_libraries": {
          "type": "integer",
          "minimum": 0
        },
        "total_nested_archives": {
          "type": "integer",
          "minimum": 0
        },
        "total_uncompressed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_compressed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "resource_breakdown": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "security_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "main_class",
        "class_path",
        "created_by",
        "build_jdk",
        "raw_attributes"
      ],
      "properties": {
        "main_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "class_path": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "build_jdk": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "class_file_info": {
      "type": "object",
      "required": [
        "min_major_version",
        "max_major_version",
        "min_java_version",
        "max_java_version",
        "unique_major_versions",
        "has_native_methods"
      ],
      "properties": {
        "min_major_version": {
          "type": "integer"
        },
        "max_major_version": {
          "type": "integer"
        },
        "min_java_version": {
          "type": "string"
        },
        "max_java_version": {
          "type": "string"
        },
        "unique_major_versions": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "has_native_methods": {
          "type": "boolean"
        }
      }
    },
    "features_detected": {
      "type": "object",
      "required": [
        "gui_frameworks",
        "audio_apis",
        "threading_apis",
        "io_apis",
        "network_apis",
        "reflection_apis",
        "external_libraries",
        "native_features"
      ],
      "properties": {
        "gui_frameworks": {
          "$ref": "#/definitions/featureList"
        },
        "audio_apis": {
          "$ref": "#/definitions/featureList"
        },
        "threading_apis": {
          "$ref": "#/definitions/featureList"
        },
        "io_apis": {
          "$ref": "#/definitions/featureList"
        },
        "network_apis": {
          "$ref": "#/definitions/featureList"
        },
        "reflection_apis": {
          "$ref": "#/definitions/featureList"
        },
        "external_libraries": {
          "$ref": "#/definitions/featureList"
        },
        "native_features": {
          "$ref": "#/definitions/featureList"
        }
      }
    },
    "backend_compatibility": {
      "type": "object",
      "required": [
        "cheerpj",
        "teavm",
        "swingjs"
      ],
      "properties": {
        "cheerpj": {
          "$ref": "#/definitions/backendEvaluation"
        },
        "teavm": {
          "$ref": "#/definitions/backendEvaluation"
        },
        "swingjs": {
          "$ref": "#/definitions/backendEvaluation"
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": [
        "primary_backend",
        "secondary_backend",
        "feasibility",
        "key_takeaways"
      ],
      "properties": {
        "primary_backend": {
          "type": "string"
        },
        "secondary_backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "feasibility": {
          "type": "string",
          "enum": [
            "ready",
            "workaround_required",
            "blocked"
          ]
        },
        "key_takeaways": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "$ref": "#/definitions/lifecycle"
    }
  },
  "definitions": {
    "feature": {
      "type": "object",
      "required": [
        "category",
        "name",
        "description",
        "severity",
        "matched_symbols"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "blocker"
          ]
        },
        "matched_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "featureList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/feature"
      }
    },
    "backendEvaluation": {
      "type": "object",
      "required": [
        "backend_id",
        "backend_name",
        "is_open_source",
        "status",
        "confidence_score",
        "summary",
        "verified_capabilities",
        "assumptions_and_risks",
        "blockers",
        "workarounds_needed",
        "remediation_steps"
      ],
      "properties": {
        "backend_id": {
          "type": "string"
        },
        "backend_name": {
          "type": "string"
        },
        "is_open_source": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "supported_with_workarounds",
            "unsupported",
            "requires_source",
            "unknown"
          ]
        },
        "confidence_score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "summary": {
          "type": "string"
        },
        "verified_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions_and_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workarounds_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remediation_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "description": "Additive lifecycle block separating static predictions from browser execution evidence.",
      "required": [
        "state",
        "prediction_only",
        "execution_verified",
        "source"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "analyzed",
            "candidate",
            "built",
            "runtime_verified",
            "failed",
            "unsupported"
          ]
        },
        "prediction_only": {
          "type": "boolean"
        },
        "execution_verified": {
          "type": "boolean"
        },
        "source": {
          "type": "string"
        },
        "verification": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "not_run",
                "runtime_verified",
                "failed"
              ]
            },
            "automated": {
              "type": "boolean"
            },
            "manual": {
              "type": "boolean"
            },
            "record": {
              "type": "string"
            },
            "screenshots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "console_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
